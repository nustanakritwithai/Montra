# Ordered client extraction is a raw-byte contract, including on Windows.
# Blank lines at fragment ends belong to the original source and must be retained.
/main.js -text
/src/client/**/*.js -text whitespace=-blank-at-eof
/styles.css -text
# Preserve pre-existing whitespace within extracted CSS, including legacy rules.
/src/styles/**/*.css -text whitespace=-blank-at-eof,-blank-at-eol
/src/client-modules/**/*.js -text

# Frozen world-math reference is compared byte-for-byte on every platform.
/deploy/combat/fixtures/world-math-reference.js -text

# Preserve the independent voice-guidance characterization bytes.
/deploy/combat/fixtures/voice-guidance-reference.js -text whitespace=-blank-at-eof

# Preserve the independent pointer-gesture characterization bytes.
/deploy/combat/fixtures/pointer-gestures-reference.js -text

# Preserve the independent lighting-controller characterization bytes.
/deploy/combat/fixtures/lighting-controller-reference.js -text

# Frozen item-presentation reference retains its pinned bytes on every platform.
/deploy/combat/fixtures/item-presentation-reference.js -text

# Preserve the independent room-state synchronization characterization bytes.
/deploy/combat/fixtures/room-state-sync-reference.js -text
